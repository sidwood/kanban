{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "pnpm --filter @kanban/contracts run build && vite",
    "build": "tauri build --debug --no-bundle",
    "build:web": "pnpm --filter @kanban/contracts run build && vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @kanban/contracts run build && vue-tsc --noEmit",
    "test": "pnpm --filter @kanban/contracts run build && vitest run"
  },
  "dependencies": {
    "@kanban/contracts": "workspace:*",
    "@tauri-apps/api": "^2.9.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}

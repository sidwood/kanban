{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `comment.edit` command.",
  "properties": {
    "comment_id": {
      "description": "The Comment being edited.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "text": {
      "description": "The revised text; blank text is refused.",
      "type": "string"
    }
  },
  "required": [
    "comment_id",
    "mutation",
    "text"
  ],
  "title": "CommentEditRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "One comment row for list views (operator MCP).",
  "properties": {
    "author": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "edited_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "parent_comment_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "author",
    "body",
    "created_at",
    "id"
  ],
  "title": "CommentListItem",
  "type": "object"
}

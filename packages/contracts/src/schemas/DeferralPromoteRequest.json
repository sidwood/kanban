{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DeferralPromotionTarget": {
      "description": "Promotion is deliberate and creates a draft; it never qualifies or dispatches it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "bug"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completion": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "enum": [
                "task"
              ],
              "type": "string"
            },
            "mode": {
              "$ref": "#/definitions/TaskMode"
            },
            "subtype": {
              "$ref": "#/definitions/TaskSubtype"
            }
          },
          "required": [
            "completion",
            "kind",
            "mode",
            "subtype"
          ],
          "type": "object"
        }
      ]
    },
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "TaskMode": {
      "description": "The closed Task mode vocabulary on the wire (KAN-S4-US4): whether a human or an agent executes the bounded work.",
      "oneOf": [
        {
          "description": "Sid executes the work.",
          "enum": [
            "human"
          ],
          "type": "string"
        },
        {
          "description": "An agent executes the work under dispatch.",
          "enum": [
            "agent"
          ],
          "type": "string"
        }
      ]
    },
    "TaskSubtype": {
      "description": "The closed Task subtype vocabulary on the wire (DR-TK-06): the seven bounded flavours of non-story work.",
      "oneOf": [
        {
          "description": "Keeping the product and its operations running.",
          "enum": [
            "operational"
          ],
          "type": "string"
        },
        {
          "description": "Finding out what is true before acting on it.",
          "enum": [
            "investigative"
          ],
          "type": "string"
        },
        {
          "description": "Bookkeeping and record-keeping work.",
          "enum": [
            "administrative"
          ],
          "type": "string"
        },
        {
          "description": "Learning without a deliverable committed up front.",
          "enum": [
            "research"
          ],
          "type": "string"
        },
        {
          "description": "Proving an approach before committing to it.",
          "enum": [
            "prototype"
          ],
          "type": "string"
        },
        {
          "description": "Moving work or data from one place to another.",
          "enum": [
            "migration"
          ],
          "type": "string"
        },
        {
          "description": "Work done by hand, on purpose.",
          "enum": [
            "manual"
          ],
          "type": "string"
        }
      ]
    },
    "TicketPriority": {
      "description": "The closed priority vocabulary on the wire (DR-LC-12): urgent, high, normal, low.",
      "oneOf": [
        {
          "description": "Ahead of everything else.",
          "enum": [
            "urgent"
          ],
          "type": "string"
        },
        {
          "description": "Ahead of normal work.",
          "enum": [
            "high"
          ],
          "type": "string"
        },
        {
          "description": "The everyday order.",
          "enum": [
            "normal"
          ],
          "type": "string"
        },
        {
          "description": "Behind normal work.",
          "enum": [
            "low"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "deferral_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "priority": {
      "$ref": "#/definitions/TicketPriority"
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "target": {
      "$ref": "#/definitions/DeferralPromotionTarget"
    }
  },
  "required": [
    "deferral_id",
    "mutation",
    "priority",
    "project_id",
    "target"
  ],
  "title": "DeferralPromoteRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CapabilityRecord": {
      "additionalProperties": false,
      "description": "One minted, run-scoped capability as every client sees it.",
      "properties": {
        "dispatch_request_id": {
          "description": "The Dispatch Request whose won claim minted this capability.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "id": {
          "description": "The storage-assigned identity.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "lane_id": {
          "description": "The Lane the run executes in.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "minted_at": {
          "description": "When the capability was minted, as unix seconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "operations": {
          "description": "The permitted MCP operations, canonical and ordered.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reviewer_slot_id": {
          "description": "The Review Slot occupied, for a reviewer.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/definitions/CapabilityRole"
            }
          ],
          "description": "The run role granted."
        },
        "settled_at": {
          "description": "When run settlement expired it, as unix seconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/CapabilityStatus"
            }
          ],
          "description": "Live or settled."
        },
        "ticket_id": {
          "description": "The Ticket the run executes.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "dispatch_request_id",
        "id",
        "lane_id",
        "minted_at",
        "operations",
        "role",
        "status",
        "ticket_id"
      ],
      "type": "object"
    },
    "CapabilityRole": {
      "description": "The run role a capability grants, on the wire.",
      "oneOf": [
        {
          "description": "Executing an Implementation or Bug Ticket in a Lane.",
          "enum": [
            "implementer"
          ],
          "type": "string"
        },
        {
          "description": "Reviewing one Review Slot.",
          "enum": [
            "reviewer"
          ],
          "type": "string"
        }
      ]
    },
    "CapabilityStatus": {
      "description": "The closed capability status on the wire: live until run settlement expires it. Settled is terminal; nothing renews.",
      "oneOf": [
        {
          "description": "Live from the mint until the run settles.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "Expired with run settlement. Terminal.",
          "enum": [
            "settled"
          ],
          "type": "string"
        }
      ]
    },
    "DispatchRequestRecord": {
      "additionalProperties": false,
      "description": "One Dispatch Request as every client sees it.",
      "properties": {
        "created_at": {
          "description": "When the request entered the queue, as unix seconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "harness": {
          "description": "The snapshotted harness family.",
          "type": "string"
        },
        "id": {
          "description": "The storage-assigned identity.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "model": {
          "description": "The snapshotted model family.",
          "type": "string"
        },
        "priority": {
          "allOf": [
            {
              "$ref": "#/definitions/TicketPriority"
            }
          ],
          "description": "The priority snapshotted at enqueue."
        },
        "project_id": {
          "description": "The Project the request belongs to.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "ready": {
          "description": "Whether the Ticket was ready at enqueue.",
          "type": "boolean"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/DispatchStatus"
            }
          ],
          "description": "Queued or claimed."
        },
        "ticket_id": {
          "description": "The Ticket the request dispatches.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "usage_pool": {
          "description": "The snapshotted usage pool.",
          "type": "string"
        },
        "version": {
          "description": "The aggregate version, for optimistic mutation checks.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "harness",
        "id",
        "model",
        "priority",
        "project_id",
        "ready",
        "status",
        "ticket_id",
        "usage_pool",
        "version"
      ],
      "type": "object"
    },
    "DispatchStatus": {
      "description": "The closed Dispatch Request status on the wire.",
      "oneOf": [
        {
          "description": "Waiting for a claimant, or waiting because capacity is exhausted.",
          "enum": [
            "queued"
          ],
          "type": "string"
        },
        {
          "description": "Held by the one claimant that won.",
          "enum": [
            "claimed"
          ],
          "type": "string"
        }
      ]
    },
    "TicketPriority": {
      "description": "The closed priority vocabulary on the wire (DR-LC-12): urgent, high, normal, low.",
      "oneOf": [
        {
          "description": "Ahead of everything else.",
          "enum": [
            "urgent"
          ],
          "type": "string"
        },
        {
          "description": "Ahead of normal work.",
          "enum": [
            "high"
          ],
          "type": "string"
        },
        {
          "description": "The everyday order.",
          "enum": [
            "normal"
          ],
          "type": "string"
        },
        {
          "description": "Behind normal work.",
          "enum": [
            "low"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Response payload for the `dispatch.claim` command: the request as it stands after the attempt, whether this claimant won, the capacity refusal that kept it queued when this claimant lost, and the run-scoped capability a win minted.",
  "properties": {
    "capability": {
      "anyOf": [
        {
          "$ref": "#/definitions/CapabilityRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "The capability minted with the win: the authority the run's agent holds, expiring with run settlement. A request still queued has granted none."
    },
    "capacity_refusal": {
      "description": "Why the request stayed queued, when it did.",
      "type": [
        "string",
        "null"
      ]
    },
    "claimed": {
      "description": "Whether this claimant won.",
      "type": "boolean"
    },
    "request": {
      "allOf": [
        {
          "$ref": "#/definitions/DispatchRequestRecord"
        }
      ],
      "description": "The request after the claim attempt."
    }
  },
  "required": [
    "claimed",
    "request"
  ],
  "title": "DispatchClaimResponse",
  "type": "object"
}

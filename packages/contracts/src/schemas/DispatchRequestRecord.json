{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DispatchStatus": {
      "description": "The closed Dispatch Request status on the wire.",
      "oneOf": [
        {
          "description": "Waiting for a claimant, or waiting because capacity is exhausted.",
          "enum": [
            "queued"
          ],
          "type": "string"
        },
        {
          "description": "Held by the one claimant that won.",
          "enum": [
            "claimed"
          ],
          "type": "string"
        }
      ]
    },
    "ProfileSnapshotRecord": {
      "additionalProperties": false,
      "description": "One frozen profile snapshot as every client sees it: the entry's name and its five decisions as they stood at the run's mint.",
      "properties": {
        "effort": {
          "description": "The snapshotted effort.",
          "type": "string"
        },
        "harness": {
          "description": "The snapshotted harness family.",
          "type": "string"
        },
        "model": {
          "description": "The snapshotted model family.",
          "type": "string"
        },
        "name": {
          "description": "The snapshotted entry name.",
          "type": "string"
        },
        "usage_pool": {
          "description": "The snapshotted usage pool.",
          "type": "string"
        }
      },
      "required": [
        "effort",
        "harness",
        "model",
        "name",
        "usage_pool"
      ],
      "type": "object"
    },
    "ReviewerDispatchRecord": {
      "additionalProperties": false,
      "properties": {
        "effective": {
          "$ref": "#/definitions/ProfileSnapshotRecord"
        },
        "fallback_path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requested": {
          "$ref": "#/definitions/ProfileSnapshotRecord"
        },
        "review_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "slot_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "tip": {
          "type": "string"
        }
      },
      "required": [
        "effective",
        "fallback_path",
        "requested",
        "review_id",
        "slot_id",
        "tip"
      ],
      "type": "object"
    },
    "TicketPriority": {
      "description": "The closed priority vocabulary on the wire (DR-LC-12): urgent, high, normal, low.",
      "oneOf": [
        {
          "description": "Ahead of everything else.",
          "enum": [
            "urgent"
          ],
          "type": "string"
        },
        {
          "description": "Ahead of normal work.",
          "enum": [
            "high"
          ],
          "type": "string"
        },
        {
          "description": "The everyday order.",
          "enum": [
            "normal"
          ],
          "type": "string"
        },
        {
          "description": "Behind normal work.",
          "enum": [
            "low"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "One Dispatch Request as every client sees it.",
  "properties": {
    "created_at": {
      "description": "When the request entered the queue, as unix seconds.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "harness": {
      "description": "The snapshotted harness family.",
      "type": "string"
    },
    "id": {
      "description": "The storage-assigned identity.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "model": {
      "description": "The snapshotted model family.",
      "type": "string"
    },
    "priority": {
      "allOf": [
        {
          "$ref": "#/definitions/TicketPriority"
        }
      ],
      "description": "The priority snapshotted at enqueue."
    },
    "project_id": {
      "description": "The Project the request belongs to.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "ready": {
      "description": "Whether the Ticket was ready at enqueue.",
      "type": "boolean"
    },
    "reviewer": {
      "anyOf": [
        {
          "$ref": "#/definitions/ReviewerDispatchRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "Frozen reviewer instructions, absent for implementation requests."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/DispatchStatus"
        }
      ],
      "description": "Queued or claimed."
    },
    "ticket_id": {
      "description": "The Ticket the request dispatches.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "usage_pool": {
      "description": "The snapshotted usage pool.",
      "type": "string"
    },
    "version": {
      "description": "The aggregate version, for optimistic mutation checks.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "created_at",
    "harness",
    "id",
    "model",
    "priority",
    "project_id",
    "ready",
    "status",
    "ticket_id",
    "usage_pool",
    "version"
  ],
  "title": "DispatchRequestRecord",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "EvidenceKindDto": {
      "description": "Whether an evidence item is a managed file or repository reference.",
      "enum": [
        "managed_file",
        "repository"
      ],
      "type": "string"
    },
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `evidence.attach` command.",
  "properties": {
    "commit_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_base64": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "entity_kind": {
      "type": "string"
    },
    "evidence_kind": {
      "$ref": "#/definitions/EvidenceKindDto"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "project_id": {
      "type": "string"
    },
    "relative_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "entity_id",
    "entity_kind",
    "evidence_kind",
    "mutation",
    "project_id"
  ],
  "title": "EvidenceAttachRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `evidence.list` command.",
  "properties": {
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "project_id": {
      "type": "string"
    }
  },
  "required": [
    "mutation",
    "project_id"
  ],
  "title": "EvidenceListRequest",
  "type": "object"
}

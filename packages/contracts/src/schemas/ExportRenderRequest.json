{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `export.render` command. `directory` names the directory within the Project's Seed Workspace the Markdown lands in; a directory that would leave the Seed is refused.",
  "properties": {
    "directory": {
      "type": "string"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "directory",
    "mutation",
    "project_id"
  ],
  "title": "ExportRenderRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DeferralPromotionRecord": {
      "additionalProperties": false,
      "properties": {
        "deferral_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "finding_id": {
          "type": "string"
        },
        "project_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "ticket_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deferral_id",
        "finding_id",
        "project_id",
        "ticket_id"
      ],
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "type": "string"
    },
    "ReviewFindingRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "string"
        },
        "in_scope": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "proposed_resolution": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/FindingSeverity"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "in_scope",
        "location",
        "proposed_resolution",
        "severity",
        "summary"
      ],
      "type": "object"
    }
  },
  "properties": {
    "blocking": {
      "type": "boolean"
    },
    "counts_for_resolution": {
      "type": "boolean"
    },
    "finding": {
      "$ref": "#/definitions/ReviewFindingRecord"
    },
    "id": {
      "type": "string"
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "promotion": {
      "anyOf": [
        {
          "$ref": "#/definitions/DeferralPromotionRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "slot_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "submission_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ticket_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "tip": {
      "type": "string"
    }
  },
  "required": [
    "blocking",
    "counts_for_resolution",
    "finding",
    "id",
    "project_id",
    "review_id",
    "slot_id",
    "ticket_id",
    "tip"
  ],
  "title": "FindingRecord",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Global defaults applied to new Projects and unset fields.",
  "properties": {
    "missing_result_deadline_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "reconciliation_interval_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "stall_deadline_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "missing_result_deadline_secs",
    "reconciliation_interval_secs",
    "stall_deadline_secs",
    "version"
  ],
  "title": "HerdrGlobalDefaults",
  "type": "object"
}

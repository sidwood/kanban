{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor": {
      "description": "Opaque page boundary. A numeric ticket id is still accepted. A newly issued cursor also carries the update stamp it was issued against.",
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "default": 0,
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "milestone_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "parent_id": {
      "description": "Parent issue by key (`CODE-123`) or numeric ticket id. JSON `null` clears the filter.",
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "team_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "updated_since": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "IssueListQuery",
  "type": "object"
}

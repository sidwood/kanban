{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "IssueChildRecord": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "sort_order": {
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "sort_order",
        "state",
        "title"
      ],
      "type": "object"
    },
    "IssueRecord": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/definitions/IssueChildRecord"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "milestone_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "project_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "relations": {
          "items": {
            "$ref": "#/definitions/IssueRelationRecord"
          },
          "type": "array"
        },
        "state": {
          "type": "string"
        },
        "state_history": {
          "items": {
            "$ref": "#/definitions/IssueStateHistoryRecord"
          },
          "type": "array"
        },
        "state_type": {
          "type": "string"
        },
        "ticket_id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "description",
        "identifier",
        "labels",
        "priority",
        "project_id",
        "relations",
        "state",
        "state_history",
        "state_type",
        "ticket_id",
        "title",
        "updated_at",
        "url",
        "version"
      ],
      "type": "object"
    },
    "IssueRelationRecord": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "kind"
      ],
      "type": "object"
    },
    "IssueStateHistoryRecord": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "state_type": {
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "state",
        "state_type"
      ],
      "type": "object"
    }
  },
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/definitions/IssueRecord"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "issues"
  ],
  "title": "IssueListResponse",
  "type": "object"
}

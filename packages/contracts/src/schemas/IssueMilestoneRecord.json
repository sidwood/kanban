{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "issues_done": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "issues_total": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "target_date": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "issues_done",
    "issues_total",
    "name"
  ],
  "title": "IssueMilestoneRecord",
  "type": "object"
}

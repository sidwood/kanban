{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "IssueProjectRecord": {
      "additionalProperties": false,
      "properties": {
        "auto_close_sub_issues": {
          "description": "Whether an open parent closes once every sub-issue is closed.",
          "type": "boolean"
        },
        "close_sub_issues_with_parent": {
          "description": "Whether a parent's open sub-issues close when the parent closes.",
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "auto_close_sub_issues",
        "close_sub_issues_with_parent",
        "code",
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "projects": {
      "items": {
        "$ref": "#/definitions/IssueProjectRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "projects"
  ],
  "title": "IssueProjectsResponse",
  "type": "object"
}

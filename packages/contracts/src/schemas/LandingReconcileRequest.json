{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "LandingRecoveryPolicy": {
      "description": "Operator policy for `landing.reconcile`.",
      "enum": [
        "complete",
        "release"
      ],
      "type": "string"
    },
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `landing.reconcile` command.",
  "properties": {
    "intent_key": {
      "type": "string"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "policy": {
      "$ref": "#/definitions/LandingRecoveryPolicy"
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "intent_key",
    "mutation",
    "policy",
    "project_id"
  ],
  "title": "LandingReconcileRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Metadata every mutation must carry so retries and stale edits are safe.",
  "properties": {
    "idempotency_key": {
      "type": "string"
    },
    "optimistic_version": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "idempotency_key",
    "optimistic_version"
  ],
  "title": "MutationContext",
  "type": "object"
}

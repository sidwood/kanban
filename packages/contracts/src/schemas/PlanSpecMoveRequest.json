{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `plan.spec.move` command.",
  "properties": {
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "plan_id": {
      "description": "The Plan whose display order changes.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "position": {
      "description": "The position in the display order the Spec moves to.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "spec_number": {
      "description": "The Spec number moving.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "mutation",
    "plan_id",
    "position",
    "spec_number"
  ],
  "title": "PlanSpecMoveRequest",
  "type": "object"
}

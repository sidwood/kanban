{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `project.register` command.",
  "properties": {
    "code": {
      "description": "The intended code; it must match `[A-Z][A-Z0-9]{1,7}` in full and `KAN` is reserved.",
      "type": "string"
    },
    "default_branch": {
      "description": "The default branch.",
      "type": "string"
    },
    "herdr_session": {
      "description": "The Herdr session name, if one is selected; absence selects Herdr's default session.",
      "type": [
        "string",
        "null"
      ]
    },
    "herdr_workspace": {
      "description": "The required target Herdr workspace.",
      "type": "string"
    },
    "initiative_id": {
      "description": "The Initiative the Project sits under, if any.",
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "name": {
      "description": "The intended name; blank names are refused.",
      "type": "string"
    },
    "repository": {
      "description": "The target Git repository; non-Git targets are refused.",
      "type": "string"
    },
    "seed_workspace": {
      "description": "The Seed Workspace.",
      "type": "string"
    }
  },
  "required": [
    "code",
    "default_branch",
    "herdr_workspace",
    "mutation",
    "name",
    "repository",
    "seed_workspace"
  ],
  "title": "ProjectRegisterRequest",
  "type": "object"
}

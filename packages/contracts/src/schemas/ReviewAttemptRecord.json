{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "invalidations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outcome": {
      "type": "string"
    },
    "review_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "verdicts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "attempt",
    "invalidations",
    "outcome",
    "verdicts"
  ],
  "title": "ReviewAttemptRecord",
  "type": "object"
}

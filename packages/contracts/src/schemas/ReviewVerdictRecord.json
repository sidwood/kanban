{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "FindingSeverity": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "type": "string"
    },
    "ReviewFindingRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "string"
        },
        "in_scope": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "proposed_resolution": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/FindingSeverity"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "in_scope",
        "location",
        "proposed_resolution",
        "severity",
        "summary"
      ],
      "type": "object"
    }
  },
  "properties": {
    "approve": {
      "type": "boolean"
    },
    "counts_for_resolution": {
      "description": "Late optional results remain evidence but cannot rewrite a resolved stage.",
      "type": "boolean"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ReviewFindingRecord"
      },
      "type": "array"
    },
    "submission_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "tip": {
      "type": "string"
    }
  },
  "required": [
    "approve",
    "counts_for_resolution",
    "summary",
    "tip"
  ],
  "title": "ReviewVerdictRecord",
  "type": "object"
}

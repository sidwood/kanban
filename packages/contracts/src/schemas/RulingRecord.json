{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "TimelineEntityKind": {
      "description": "Entity kinds that may appear on the activity timeline.",
      "enum": [
        "initiative",
        "project",
        "plan",
        "spec",
        "ticket",
        "run",
        "review",
        "finding",
        "evidence",
        "comment",
        "workspace",
        "lane",
        "profile"
      ],
      "type": "string"
    },
    "TimelineEntityRef": {
      "additionalProperties": false,
      "description": "A timeline-visible entity reference.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TimelineEntityKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    }
  },
  "description": "One immutable ruling as every client sees it.",
  "properties": {
    "entity": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimelineEntityRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "The entity the ruling concerns, if any."
    },
    "id": {
      "description": "The storage-assigned identity.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "project_id": {
      "description": "The project the ruling belongs to.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "recorded_at": {
      "description": "When the ruling was recorded.",
      "type": "string"
    },
    "summary": {
      "description": "The operator decision text.",
      "type": "string"
    },
    "supersedes_id": {
      "description": "The ruling this one supersedes, if any.",
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "project_id",
    "recorded_at",
    "summary"
  ],
  "title": "RulingRecord",
  "type": "object"
}

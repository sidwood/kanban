{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "TimelineEntityKind": {
      "description": "Entity kinds that may appear on the activity timeline.",
      "enum": [
        "initiative",
        "project",
        "plan",
        "spec",
        "ticket",
        "run",
        "review",
        "finding",
        "evidence",
        "comment"
      ],
      "type": "string"
    },
    "TimelineEntityRef": {
      "additionalProperties": false,
      "description": "A timeline-visible entity reference.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TimelineEntityKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `ruling.record` command.",
  "properties": {
    "entity": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimelineEntityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "project_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "mutation",
    "project_id",
    "summary"
  ],
  "title": "RulingRecordRequest",
  "type": "object"
}

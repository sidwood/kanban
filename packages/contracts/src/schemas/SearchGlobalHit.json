{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "SearchHitKind": {
      "description": "The kind of entity one search hit names.",
      "enum": [
        "initiative",
        "project",
        "plan",
        "spec",
        "ticket"
      ],
      "type": "string"
    }
  },
  "description": "One row the `search.global` query returns.",
  "properties": {
    "id": {
      "description": "The immutable, storage-assigned identity.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "identifier": {
      "description": "The identifier the operator would quote: `CORE-T12`, `CORE`, or an Initiative name.",
      "type": "string"
    },
    "kind": {
      "allOf": [
        {
          "$ref": "#/definitions/SearchHitKind"
        }
      ],
      "description": "The kind of entity this hit names."
    },
    "label": {
      "description": "The line the palette leads with: a title, a name, or a plan label.",
      "type": "string"
    },
    "project_id": {
      "description": "The Project this hit belongs to, when one exists.",
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "identifier",
    "kind",
    "label"
  ],
  "title": "SearchGlobalHit",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "SpecExecutionState": {
      "description": "The closed Spec execution vocabulary on the wire (DR-PS-12), tracked separately from every content version.",
      "enum": [
        "unplanned",
        "planned",
        "blocked",
        "ready",
        "active",
        "integration_review",
        "complete",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "description": "Request payload for the `spec.execution.move` command.",
  "properties": {
    "execution": {
      "allOf": [
        {
          "$ref": "#/definitions/SpecExecutionState"
        }
      ],
      "description": "The target state, which must be a legal transition away (DR-PS-12). `planned` is reached by joining a Plan, never by this command."
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "spec_id": {
      "description": "The Spec whose execution moves.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "execution",
    "mutation",
    "spec_id"
  ],
  "title": "SpecExecutionMoveRequest",
  "type": "object"
}

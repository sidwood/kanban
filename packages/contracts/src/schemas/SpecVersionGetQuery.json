{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Request payload for the `spec.version.get` query.",
  "properties": {
    "number": {
      "description": "The version being read — the pin a Ticket resolves through, superseded versions included.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "spec_id": {
      "description": "The Spec owning the version.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "number",
    "spec_id"
  ],
  "title": "SpecVersionGetQuery",
  "type": "object"
}

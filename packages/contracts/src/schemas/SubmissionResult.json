{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FindingSeverity": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "type": "string"
    },
    "ReviewFindingRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "string"
        },
        "in_scope": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "proposed_resolution": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/FindingSeverity"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "in_scope",
        "location",
        "proposed_resolution",
        "severity",
        "summary"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "implementation"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tip": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary",
        "tip"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "approve": {
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ReviewFindingRecord"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "review"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tip": {
          "type": "string"
        }
      },
      "required": [
        "approve",
        "kind",
        "summary",
        "tip"
      ],
      "type": "object"
    }
  ],
  "title": "SubmissionResult"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `ticket.blocker.remove` command: removing an external blocker is the explicit operator action that clears it (DR-DE-04).",
  "properties": {
    "blocker_id": {
      "description": "The recorded blocker being removed.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "ticket_id": {
      "description": "The Ticket the blocker was recorded against.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "blocker_id",
    "mutation",
    "ticket_id"
  ],
  "title": "TicketBlockerRemoveRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "TicketState": {
      "description": "The closed Ticket lifecycle vocabulary on the wire (DR-LC-01): the canonical states in order, with the terminal states after them. Every Ticket is created into draft; the transition rules are the lifecycle slice's.",
      "oneOf": [
        {
          "description": "Newly created; not yet qualified or planned.",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Deliberately set aside.",
          "enum": [
            "parked"
          ],
          "type": "string"
        },
        {
          "description": "Waiting on something outside the Ticket.",
          "enum": [
            "blocked"
          ],
          "type": "string"
        },
        {
          "description": "Qualified but unavailable until activation.",
          "enum": [
            "scheduled"
          ],
          "type": "string"
        },
        {
          "description": "Free to execute when capacity allows.",
          "enum": [
            "ready"
          ],
          "type": "string"
        },
        {
          "description": "Executing.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "Under review.",
          "enum": [
            "in_review"
          ],
          "type": "string"
        },
        {
          "description": "Review approved, waiting to land.",
          "enum": [
            "approved"
          ],
          "type": "string"
        },
        {
          "description": "Landing through the Seed Workspace.",
          "enum": [
            "landing"
          ],
          "type": "string"
        },
        {
          "description": "Landed in full.",
          "enum": [
            "done"
          ],
          "type": "string"
        },
        {
          "description": "Terminal: will not execute.",
          "enum": [
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "Terminal: replaced by a reassignment Ticket.",
          "enum": [
            "superseded"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Request payload for the `ticket.emergency.override` command: recovery moves a Ticket to any state past the rules, on the strength of the justification the audit row carries — who ran it and why (DR-LC-10). This command is the only way past the rules; no unrestricted drag exists.",
  "properties": {
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "ticket_id": {
      "description": "The Ticket being recovered.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "to": {
      "allOf": [
        {
          "$ref": "#/definitions/TicketState"
        }
      ],
      "description": "The state recovery names."
    },
    "who": {
      "description": "Who ran the override, recorded on the timeline.",
      "type": "string"
    },
    "why": {
      "description": "Why the override ran, recorded on the timeline.",
      "type": "string"
    }
  },
  "required": [
    "mutation",
    "ticket_id",
    "to",
    "who",
    "why"
  ],
  "title": "TicketEmergencyOverrideRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `ticket.graph.approve` command: the human gate's decision on one proposed graph (DR-PS-17). Approval pins every Ticket in the graph to the Spec version it named.",
  "properties": {
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "proposal_id": {
      "description": "The proposal being approved.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "mutation",
    "proposal_id"
  ],
  "title": "TicketGraphApproveRequest",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "TicketPriority": {
      "description": "The closed priority vocabulary on the wire (DR-LC-12): urgent, high, normal, low.",
      "oneOf": [
        {
          "description": "Ahead of everything else.",
          "enum": [
            "urgent"
          ],
          "type": "string"
        },
        {
          "description": "Ahead of normal work.",
          "enum": [
            "high"
          ],
          "type": "string"
        },
        {
          "description": "The everyday order.",
          "enum": [
            "normal"
          ],
          "type": "string"
        },
        {
          "description": "Behind normal work.",
          "enum": [
            "low"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Request payload for the `ticket.prioritise` command: set the Ticket's priority from the closed vocabulary (DR-LC-09, DR-LC-12).",
  "properties": {
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "priority": {
      "allOf": [
        {
          "$ref": "#/definitions/TicketPriority"
        }
      ],
      "description": "The priority being set."
    },
    "ticket_id": {
      "description": "The Ticket being prioritised.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "mutation",
    "priority",
    "ticket_id"
  ],
  "title": "TicketPrioritiseRequest",
  "type": "object"
}

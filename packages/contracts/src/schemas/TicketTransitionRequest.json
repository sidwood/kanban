{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    },
    "TicketState": {
      "description": "The closed Ticket lifecycle vocabulary on the wire (DR-LC-01): the canonical states in order, with the terminal states after them. Every Ticket is created into draft; the transition rules are the lifecycle slice's.",
      "oneOf": [
        {
          "description": "Newly created; not yet qualified or planned.",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Deliberately set aside.",
          "enum": [
            "parked"
          ],
          "type": "string"
        },
        {
          "description": "Waiting on something outside the Ticket.",
          "enum": [
            "blocked"
          ],
          "type": "string"
        },
        {
          "description": "Qualified but unavailable until activation.",
          "enum": [
            "scheduled"
          ],
          "type": "string"
        },
        {
          "description": "Free to execute when capacity allows.",
          "enum": [
            "ready"
          ],
          "type": "string"
        },
        {
          "description": "Executing.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "Under review.",
          "enum": [
            "in_review"
          ],
          "type": "string"
        },
        {
          "description": "Review approved, waiting to land.",
          "enum": [
            "approved"
          ],
          "type": "string"
        },
        {
          "description": "Landing through the Seed Workspace.",
          "enum": [
            "landing"
          ],
          "type": "string"
        },
        {
          "description": "Landed in full.",
          "enum": [
            "done"
          ],
          "type": "string"
        },
        {
          "description": "Terminal: will not execute.",
          "enum": [
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "Terminal: replaced by a reassignment Ticket.",
          "enum": [
            "superseded"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Request payload for the `ticket.transition` command: a drag moves a Task Ticket to a legal target along the canonical lifecycle (DR-LC-07). A drag of an Implementation or Bug Ticket is refused with the explanation that those transitions are agent-owned (DR-LC-08).",
  "properties": {
    "mutation": {
      "$ref": "#/definitions/MutationContext"
    },
    "ticket_id": {
      "description": "The Ticket being dragged.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "to": {
      "allOf": [
        {
          "$ref": "#/definitions/TicketState"
        }
      ],
      "description": "The state the drag names."
    }
  },
  "required": [
    "mutation",
    "ticket_id",
    "to"
  ],
  "title": "TicketTransitionRequest",
  "type": "object"
}

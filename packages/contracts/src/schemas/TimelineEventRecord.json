{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "TimelineEntityKind": {
      "description": "Entity kinds that may appear on the activity timeline.",
      "enum": [
        "initiative",
        "project",
        "plan",
        "spec",
        "ticket",
        "run",
        "review",
        "finding",
        "evidence",
        "comment",
        "workspace",
        "lane",
        "profile"
      ],
      "type": "string"
    },
    "TimelineEntityRef": {
      "additionalProperties": false,
      "description": "A timeline-visible entity reference.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TimelineEntityKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "TimelineEventKind": {
      "description": "The closed vocabulary of timeline event kinds (DR-AE-01).",
      "enum": [
        "transition",
        "run",
        "telemetry",
        "review",
        "finding",
        "evidence",
        "comment",
        "deferral",
        "ruling"
      ],
      "type": "string"
    },
    "TimelineScope": {
      "description": "Where a timeline row belongs. Entities that sit above every Project — Initiatives, for one — are recorded globally; everything inside a Project is recorded against that Project's numeric identity, resolved through the Project store before any write.",
      "oneOf": [
        {
          "description": "Above every Project.",
          "enum": [
            "global"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One Project's own timeline, named by its numeric identity.",
          "properties": {
            "project": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "project"
          ],
          "type": "object"
        }
      ]
    }
  },
  "description": "One append-only timeline row as returned by queries.",
  "properties": {
    "detail": true,
    "entity": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimelineEntityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "kind": {
      "$ref": "#/definitions/TimelineEventKind"
    },
    "recorded_at": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/definitions/TimelineScope"
    }
  },
  "required": [
    "detail",
    "id",
    "kind",
    "recorded_at",
    "scope"
  ],
  "title": "TimelineEventRecord",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "TimelineEntityKind": {
      "description": "Entity kinds that may appear on the activity timeline.",
      "enum": [
        "initiative",
        "project",
        "plan",
        "spec",
        "ticket",
        "run",
        "review",
        "finding",
        "evidence",
        "comment"
      ],
      "type": "string"
    },
    "TimelineEntityRef": {
      "additionalProperties": false,
      "description": "A timeline-visible entity reference.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TimelineEntityKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "TimelineEventKind": {
      "description": "The closed vocabulary of timeline event kinds (DR-AE-01).",
      "enum": [
        "transition",
        "run",
        "telemetry",
        "review",
        "finding",
        "evidence",
        "comment",
        "deferral",
        "ruling"
      ],
      "type": "string"
    }
  },
  "description": "One append-only timeline row as returned by queries.",
  "properties": {
    "detail": true,
    "entity": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimelineEntityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "kind": {
      "$ref": "#/definitions/TimelineEventKind"
    },
    "project_id": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    }
  },
  "required": [
    "detail",
    "id",
    "kind",
    "project_id",
    "recorded_at"
  ],
  "title": "TimelineEventRecord",
  "type": "object"
}

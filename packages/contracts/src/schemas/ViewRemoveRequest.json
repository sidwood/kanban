{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `view.remove` command. Removing a scope's default is legal: the next read generates it again (DR-BP-06).",
  "properties": {
    "mutation": {
      "allOf": [
        {
          "$ref": "#/definitions/MutationContext"
        }
      ],
      "description": "The mutation context."
    },
    "view_id": {
      "description": "The view being removed.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "mutation",
    "view_id"
  ],
  "title": "ViewRemoveRequest",
  "type": "object"
}

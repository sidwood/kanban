{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MutationContext": {
      "additionalProperties": false,
      "description": "Metadata every mutation must carry so retries and stale edits are safe.",
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "optimistic_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "optimistic_version"
      ],
      "type": "object"
    }
  },
  "description": "Request payload for the `view.rename` command: the name changes, nothing else.",
  "properties": {
    "mutation": {
      "allOf": [
        {
          "$ref": "#/definitions/MutationContext"
        }
      ],
      "description": "The mutation context."
    },
    "name": {
      "description": "The perspective's new name, unique within its scope.",
      "type": "string"
    },
    "view_id": {
      "description": "The view being renamed.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "mutation",
    "name",
    "view_id"
  ],
  "title": "ViewRenameRequest",
  "type": "object"
}

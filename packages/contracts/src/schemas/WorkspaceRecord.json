{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "WorkspaceHealthDto": {
      "description": "The closed health vocabulary as every client sees it.",
      "enum": [
        "available",
        "assigned",
        "dirty",
        "missing",
        "retired"
      ],
      "type": "string"
    },
    "WorkspaceObservationDto": {
      "additionalProperties": false,
      "description": "The git facts the core last observed without mutating the clone.",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane_assignment": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "repository_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "unique_unlanded_commits": {
          "description": "Whether the Workspace holds unique unlanded commits; absent when the observer could not decide.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "working_tree_clean": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkspaceReuseDto": {
      "additionalProperties": false,
      "description": "The reuse verdict with every condition evaluated (DR-LW-06).",
      "properties": {
        "clean": {
          "description": "The working tree is clean on a present path.",
          "type": "boolean"
        },
        "free_of_unlanded_commits": {
          "description": "No unique unlanded commits sit on the Workspace.",
          "type": "boolean"
        },
        "reusable": {
          "description": "Reusable only when every condition holds and the record is present and not retired.",
          "type": "boolean"
        },
        "unassigned": {
          "description": "No Lane assignment holds the Workspace.",
          "type": "boolean"
        }
      },
      "required": [
        "clean",
        "free_of_unlanded_commits",
        "reusable",
        "unassigned"
      ],
      "type": "object"
    }
  },
  "description": "The Workspace record as every client sees it.",
  "properties": {
    "health": {
      "$ref": "#/definitions/WorkspaceHealthDto"
    },
    "id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "is_seed": {
      "type": "boolean"
    },
    "observation": {
      "$ref": "#/definitions/WorkspaceObservationDto"
    },
    "path": {
      "type": "string"
    },
    "project_id": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "reuse": {
      "$ref": "#/definitions/WorkspaceReuseDto"
    },
    "version": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "health",
    "id",
    "is_seed",
    "observation",
    "path",
    "project_id",
    "reuse",
    "version"
  ],
  "title": "WorkspaceRecord",
  "type": "object"
}
